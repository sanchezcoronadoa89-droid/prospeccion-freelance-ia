 "cards": [
  {
   "dot": "cyan",
   "title": "Cómo se lee",
   "items": [
    "Cada dominio ocupa un bloque: fuentes e ingesta, proyectos y evaluación, agentes y fase 2.",
    "Las relaciones van del hijo a la tabla que referencia; una línea opcional es una clave que puede quedar vacía."
   ]
  },
  {
   "dot": "amber",
   "title": "Claves sin línea",
   "items": [
    "ratings.target_id apunta a projects o a sources según target_type, sin clave foránea.",
    "projects.near_duplicate_of apunta a otro proyecto de la misma tabla (casi duplicado).",
    "projects es única por source_id + external_id."
   ]
  },
  {
   "dot": "emerald",
   "title": "Trazabilidad",
   "items": [
    "Cada resultado de agente guarda corrida, modelo y versión de prompt o rúbrica.",
    "labels separa auditoría y golden set con golden_version y label_pass."
   ]
  },
  {
   "dot": "slate",
   "title": "Fase 2",
   "items": [
    "brief_analyses, profitability y market_metrics existen pero siguen vacías."
   ]
  }
 ]
}